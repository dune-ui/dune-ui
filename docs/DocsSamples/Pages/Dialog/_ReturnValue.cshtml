<div class="min-h-[450px]">
    <!-- code begin -->
    <div class="flex justify-center">
        <dui-button variant="ButtonVariant.Outline" commandfor="--dialog-return-value" command="show-modal">
            Open Alert Dialog
        </dui-button>
    </div>
    <dui-dialog id="--dialog-return-value">
        <dui-dialog-header>
            <dui-dialog-title>Are you absolutely sure?</dui-dialog-title>
            <dui-dialog-description>
                This action cannot be undone. This will permanently delete your account from our servers.
            </dui-dialog-description>
        </dui-dialog-header>
        <form method="dialog">
            <dui-dialog-footer>
                <dui-button variant="ButtonVariant.Outline" type="submit" value="cancel">
                    Cancel
                </dui-button>
                <dui-button type="submit" value="confirm" autofocus>
                    Continue
                </dui-button>
            </dui-dialog-footer>
        </form>
    </dui-dialog>
    <script>
        const dialogReturnValueDialog = document.getElementById("--dialog-return-value");

        dialogReturnValueDialog.addEventListener("close", () => {
            const cancelled = !dialogReturnValueDialog.returnValue || dialogReturnValueDialog.returnValue === "cancel";
            if (cancelled) {
                alert("The action has been cancelled");
                return;
            }

            alert("The action has been confirmed");
        });
    </script>
    <!-- code end -->
</div>
