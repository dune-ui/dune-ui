<div class="min-h-[450px]">
    <!-- code begin -->
    <dui-button variant="ButtonVariant.Outline" commandfor="--dialog-default-open" command="show-modal">
        Open
    </dui-button>
    <dui-dialog id="--dialog-default-open" open>
        <dui-dialog-header>
            <dui-dialog-title>Default Open</dui-dialog-title>
        </dui-dialog-header>
        This dialog is open by default.
        <dui-dialog-footer>
            <dui-button variant="ButtonVariant.Outline" commandfor="--dialog-default-open" command="close">
                Close
            </dui-button>
        </dui-dialog-footer>
    </dui-dialog>
    <!-- code end -->
</div>
