<dui-sidebar-wrapper>
    <dui-sidebar variant="SidebarVariant.Inset">
        <dui-sidebar-header>
            <div class="px-2 py-1 text-sm font-semibold">Dune UI</div>
        </dui-sidebar-header>
        <dui-sidebar-content>
            <div class="px-2 py-1 text-sm text-sidebar-foreground/70">Sidebar content</div>
        </dui-sidebar-content>
    </dui-sidebar>
    <dui-sidebar-inset>
        <header class="flex h-14 items-center gap-2 border-b px-4">
            <dui-sidebar-trigger></dui-sidebar-trigger>
            <span class="text-sm text-muted-foreground">Toggle the sidebar (Ctrl/⌘ + B)</span>
        </header>
        <div class="p-4">This is a basic sidebar with a trigger.</div>
    </dui-sidebar-inset>
</dui-sidebar-wrapper>
