            </dui-dropdown-menu-trigger>
            <dui-dropdown-menu-content class="w-56">
                <dui-dropdown-menu-label>My Account</dui-dropdown-menu-label>
                <dui-dropdown-menu-separator/>
                <dui-dropdown-menu-group>
                    <dui-dropdown-menu-item>
