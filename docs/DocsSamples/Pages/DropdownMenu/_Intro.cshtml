<div class="min-h-[330px]">
    <dui-group justify="GroupJustify.Center">
        <!-- code begin -->
        <dui-dropdown-menu>
            <dui-dropdown-menu-trigger variant="ButtonVariant.Outline">
                <dui-icon name="circle-user-round" class="text-muted-foreground"/>
