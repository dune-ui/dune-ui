<div class="min-h-[120px]">
    <!-- code begin -->
    <dui-group gap="GroupGap.Small">
        <dui-popover id="popover">
            <dui-popover-trigger>
                <dui-avatar src="/avatars/avatar-1.jpg"/>
            </dui-popover-trigger>
            <dui-popover-content>
                <dui-button id="closeViaJs" variant="ButtonVariant.Outline">Close via JS</dui-button>
            </dui-popover-content>
        </dui-popover>
        <dui-button id="openViaJs" variant="ButtonVariant.Outline">Open via JS</dui-button>
    </dui-group>
    <!-- code end -->
</div>
<script>
    const popover = document.getElementById("popover");
    const openViaJs = document.getElementById("openViaJs");
    openViaJs.addEventListener("click", () => {
        popover.open();
    })

    const closeViaJs = document.getElementById("closeViaJs");
    closeViaJs.addEventListener("click", () => {
        popover.close();
    })
</script>